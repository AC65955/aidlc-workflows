{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts record-human-turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts bind-bash-session"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts deliver-stage-rules"
          }
        ],
        "matcher": "spawn_agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts state-transition-guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts reviewer-scope"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts review-freeze"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts plan-approval-guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts scope-bash-command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts record-human-turn"
          }
        ],
        "matcher": "request_user_input"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts audit-and-sensors"
          }
        ],
        "matcher": "apply_patch"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts sync-workflow-state"
          }
        ],
        "matcher": "update_plan"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts rebuild-stage-graph"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts validate-state"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts log-subagent"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-session-gate.ts continue-workflow"
          }
        ]
      }
    ]
  }
}
