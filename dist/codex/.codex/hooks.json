{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts record-human-turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts deliver-stage-rules"
          }
        ],
        "matcher": "spawn_agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts state-transition-guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts reviewer-scope"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts review-freeze"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts plan-approval-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts audit-and-sensors"
          }
        ],
        "matcher": "apply_patch"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts sync-workflow-state"
          }
        ],
        "matcher": "update_plan"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts rebuild-stage-graph"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts validate-state"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts log-subagent"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/hooks/aidlc-router-wrapper.ts continue-workflow"
          }
        ]
      }
    ]
  }
}
